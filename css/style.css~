/*--------------------------------------------------------------------- File Name: style.css ---------------------------------------------------------------------*/


/*--------------------------------------------------------------------- import Fonts ---------------------------------------------------------------------*/

@import url('https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap');

/*****---------------------------------------- 1) font-family: 'Lato', sans-serif;
 ----------------------------------------*****/

/* <weight>: Use a value from 100 to 900 */
/* <uniquifier>: Use a unique and descriptive class name */

.roboto-<uniquifier> {
  font-family: "Roboto", sans-serif;
  font-optical-sizing: auto;
  font-weight: <weight>;
  font-style: normal;
  font-variation-settings:
    "wdth" 100;
}

.roboto-thin {
  font-family: "Roboto", sans-serif;
  font-optical-sizing: auto;
  font-weight: 100;
  font-style: normal;
  font-variation-settings:
    "wdth" 100;
}

.roboto-light {
  font-family: "Roboto", sans-serif;
  font-optical-sizing: auto;
  font-weight: 300;
  font-style: normal;
  font-variation-settings:
    "wdth" 100;
}

.roboto-regular {
  font-family: "Roboto", sans-serif;
  font-optical-sizing: auto;
  font-weight: 400;
  font-style: normal;
  font-variation-settings:
    "wdth" 100;
}

.roboto-bold {
  font-family: "Roboto", sans-serif;
  font-optical-sizing: auto;
  font-weight: 700;
  font-style: normal;
  font-variation-settings:
    "wdth" 100;
}

.roboto-black {
  font-family: "Roboto", sans-serif;
  font-optical-sizing: auto;
  font-weight: 900;
  font-style: normal;
  font-variation-settings:
    "wdth" 100;
}


/*--------------------------------------------------------------------- import Files ---------------------------------------------------------------------*/



/*--------------------------------------------------------------------- skeleton ---------------------------------------------------------------------*/

* {
    box-sizing: border-box !important;
    transition: ease all 0.5s;
}

*,
*::after,
*::before {
    -webkit-box-sizing: border-box;
    -moz-box-sizing: border-box;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    color: #000000;
    font-size: 14px;
    font-family: Roboto;
    background-color: #ffffff;
    padding: 20px;
}

/*-- links --*/
a {
    
}

/*-- headers --*/
h1,
h2,
h3,
h4,
h5,
h6 {
    
}

h1 {
    font-size: 30px
}

h2 {
    font-size: 24px
}

h3 {
    font-size: 20px
}

h4 {
    font-size: 18px
}

h5 {
    font-size: 16px
}

h6 {
    font-size: 15px
}

/*-- links inside headers --*/
h1 a,
h2 a,
h3 a,
h4 a,
h5 a,
h6 a {
    color: #4c4c4b;
    text-decoration: none!important;
    opacity: 1
}

/*-- unordered lists, ordered lists, list items --*/
ul, 
ol,
li {
    margin: 0px;
    padding: 0px;
    list-style: none;
}

/*-- paragraph --*/
p {
    margin: 20px 0px;
    font-weight: 300;
    font-size: 15px;
    line-height: 24px;
}

/*-- links --*/
a {
    color: #4c7031;
    text-decoration: none;
    outline: none !important;
}

/*-- links that are buttons --*/
a,
.btn {
    text-decoration: none !important;
    outline: none !important;
    -webkit-transition: all .3s ease-in-out;
    -moz-transition: all .3s ease-in-out;
    -ms-transition: all .3s ease-in-out;
    -o-transition: all .3s ease-in-out;
    transition: all .3s ease-in-out;
}

/*-- images --*/
img {
    max-width: 100%;
    height: auto;
}

/*-- what happens when an elements gets focus (when the user clicks or taps on an element or selects it with the keyboard's Tab key.) --*/
:focus {
    outline: 0;
}


/* header section start */

.header_section {
    width: 100%;
    float: left;
    text-align: center;
    background-color: #ffffff;
    height: auto;
    background-size: 100%;
}

.bg-light {
    background-color: transparent !important;
}

.header_main {
    width: 100%;
    float: left;
    background: #ffffff;
    height: 80px;
}

.navbar-light .navbar-nav .active>.nav-link,
.navbar-light .navbar-nav .nav-link.active,
.navbar-light .navbar-nav .nav-link.show,
.navbar-light .navbar-nav .show>.nav-link {
    color: #4c7031;
    font-weight: bold;
}

.navbar-light .navbar-nav .nav-link:focus,
.navbar-light .navbar-nav .nav-link:hover {
    color: #4c7031;
    font-weight: bold;
}

.navbar {
    padding: 20px 1rem;
}

.navbar-expand-lg .navbar-nav .nav-link {
    padding-right: .5rem;
    padding-left: .5rem;
    font-size: 14px;
    color: #4c7031;
}

.logo {}

/* header section end */

/* intro section start */

.intro-bio_leftcolumn {
    float: left;
    width: 30%;
    padding: 15px;
}

.intro-bio_rightcolumn {
    float: left;
    width: 60%;
    padding: 10px;
}

.intro_text {
    float: left;
    font-size: 16px;
    color: #4c4c4b;
    text-align: left;
}

.intro_img {
    margin: auto;
    align-items: center;
    max-width: 900px;
    min-width: 300px; 
}

/* intro section end */

/* about section start */

.about_section {
    width: 100%;
    float: left;
}

.about_table {
    display: flex;
    flex-flow: row wrap;
    align-items: center;
    margin: auto;
    width: 80%;
    padding: 10px;
    gap: 20px 20px;
}

.about_column {
    flex: 40;
}

.about_taital {
    width: 100%;
    float: left;
    font-size: 24px;
    color: #4c7031;
    font-weight: bold;
    line-height: 30px;
    text-align: center;
    align-items: center;
    padding: 20px 10px;
    margin: auto;
    min-width: 300px;
}

.about_text {
    float: left;
    font-size: 16px;
    color: #4c4c4b;
    text-align: left;
}

.about_img {
    margin: auto;
    align-items: center;
    max-width: 900px;
    min-width: 300px; 
}

.read_bt {
    width: 275px;
    float: left;
    padding-top: 10px;
    padding-bottom: 40px;
    position: relative;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}

.read_bt a {
    width: 100%;
    float: left;
    font-size: 18px;
    background-color: #4c7031;
    color: #ffffff;
    text-align: center;
    padding: 8px;
}

.read_bt a:hover {
    color: #ffffff;
    background-color: #f2ae1c;
}

/* about section end */

